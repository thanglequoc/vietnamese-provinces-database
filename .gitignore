.DS_Store
# Ignore lock acquired by Libre office
.~lock*

.vscode
dataset-generation-scripts/output/*
dataset-generation-scripts/.env

# Local GIS mock cache (large; regenerate with dataset-generation-scripts/pull-gis-cache.sh)
dataset-generation-scripts/resources/gis/gis_server_cache/

# Agent credentials (never commit)
.env.agent

# R2 credentials (never commit)
.env.r2

# Python bytecode
__pycache__/
*.pyc
