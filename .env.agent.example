# MongoDB credentials for the VPS MongoDB instance (accessed via SSH tunnel).
# Copy this file to .env.agent and fill in real values.
#   cp .env.agent.example .env.agent
# .env.agent is git-ignored — do NOT commit it.
# Load it in a shell with:  set -a; source .env.agent; set +a

MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=CHANGE_ME
MONGO_DB_NAME=vn_provinces
MONGO_URI="mongodb://root:CHANGE_ME@localhost:27017/?authSource=admin&directConnection=true"
