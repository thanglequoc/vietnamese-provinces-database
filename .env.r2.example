# Cloudflare R2 credentials for publishing dataset archives.
#
# This file is for LOCAL testing only (e.g. the reachability check). The
# GitHub Actions workflow uses repository Secrets/Variables instead:
#   Secrets   : R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY
#   Variables : R2_ACCOUNT_ID, R2_BUCKET_NAME, R2_PUBLIC_BASE_URL
#
# Copy to .env.r2 (git-ignored) and fill in real values:
#   cp .env.r2.example .env.r2
# Load in a shell with:
#   set -a; source .env.r2; set +a

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=https://vn-provinces-ds.thanglequoc.xyz
